{
  "name": "personal-budget",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky install",
    "gcommit": "bash ./scripts/commit.sh",
    "deploy:infra": "bash infra/deploy-sam.sh personal-budget-resources personal-budget-infra dev us-east-1",
    "deploy:infra:prod": "bash infra/deploy-sam.sh personal-budget-resources personal-budget-infra prod us-east-1",
    "test": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1004.0",
    "@aws-sdk/lib-dynamodb": "^3.1004.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.7",
    "@mui/x-date-pickers": "^7.23.6",
    "@nivo/core": "^0.88.0",
    "@nivo/sankey": "^0.88.0",
    "date-fns": "^3.6.0",
    "jose": "^6.2.0",
    "next": "^15.1.7",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.7",
    "serverless": "4.33.0",
    "typescript": "^5.7.3",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0",
    "vitest": "^1.2.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,css,scss,md,json}": [
      "pnpm dlx prettier --write",
      "git add"
    ]
  }
}
